{
    "app": {
        "cfengine": "boxlang@1",
        "serverHomeDirectory": "../../.engine/boxlang"
    },
    "name": "coldbox-perf-boxlang",
    "force": true,
    "openBrowser": false,
    "web": {
        "webroot": "../../",
        "directoryBrowsing": true,
        "http": { "port": "8599" },
        "rewrites": { "enable": true },
        "aliases": { "/coldbox": "../../" }
    },
    "JVM": {
        "heapSize": "1024",
        "javaHome": "/usr/lib/jvm/java-21-openjdk-amd64"
    },
    "cfconfig": { "file": "../../.cfconfig.json" },
    "env": { "BOXLANG_DEBUG": false }
}
